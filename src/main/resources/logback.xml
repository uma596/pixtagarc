<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- コンソール出力アペンダー -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ファイル出力アペンダー（ローリング） -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${user.home}/.pixtagarc/logs/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 日次ローリング、最大30日分保持 -->
            <fileNamePattern>${user.home}/.pixtagarc/logs/app.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ルートロガー: DEBUGレベル -->
    <root level="DEBUG">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

    <!-- JavaFX 関連の冗長ログを抑制 -->
    <logger name="javafx" level="WARN" />
    <logger name="com.sun.javafx" level="WARN" />

    <!-- VLCJ の冗長ログを抑制 -->
    <logger name="uk.co.caprica.vlcj" level="INFO" />

</configuration>
